{
    "run": {
        "project": "cs336-assignment1",
        "name": "test-run1"
    },
    "data": {
        "train_data_path": "experiments/5-training-loop/data/train.bin",
        "val_data_path": "experiments/5-training-loop/data/val.bin"
    },
    "model": {
        "vocab_size": 1000,
        "context_length": 32,
        "d_model": 64,
        "num_layers": 2,
        "num_heads": 4,
        "d_ff": 128,
        "rope_theta": 10000
    },
    "optimizer": {
        "optim": "adamw",
        "optim_args": {
            "lr": 1e-3,
            "betas": [
                0.9,
                0.999
            ],
            "eps": 1e-8,
            "weight_decay": 1e-2
        },
        "scheduler": "cosine",
        "scheduler_args": {
            "min_learning_rate": 1e-5,
            "warmup_ratio": 0.01
        }
    },
    "training": {
        "max_steps": 20,
        "batch_size": 4,
        "gradient_accumulation_steps": 1,
        "eval_steps": 5,
        "save_steps": 10,
        "eval_batches": 5,
        "clip_grad_norm": 0.0,
        "device": "mps",
        "out_dir": "checkpoints"
    }
}